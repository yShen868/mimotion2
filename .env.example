# 复制本文件为 .env。不要把 .env 提交到仓库。

# 聊天应用。和刷步通知用的应用不是同一个。
FEISHU_CHAT_APP_ID=cli_aa5d99097fb89c13
FEISHU_CHAT_APP_SECRET=

# 稍后填写。填写后重新运行 python3 feishu_chat.py
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 系统提示词。留空则读取 chat_system_prompt.txt；文件也没有时使用内置的任务工人提示词。
DEEPSEEK_SYSTEM_PROMPT=

# 提交任务并触发 GitHub Actions。填 fine-grained PAT，不要提交到仓库。
# 这个仓库需要 Contents、Workflows、Actions 读写。仓库和分支能从 git origin 识别时可以不填。
GITHUB_PAT=
GITHUB_REPOSITORY=yShen868/mimotion2
GITHUB_BRANCH=master

# 先运行一次，从日志里的「发送者 ou_」抄到这里，再重启。不填则任何人都能创建任务。
FEISHU_OWNER_OPEN_ID=

# 定时推送复用刷步已有的 FEISHU_APP_ID、FEISHU_APP_SECRET、FEISHU_RECEIVE_ID。
# 不用再为任务建飞书 Secret。
